program dataTypes;

var
  age: Integer;         // Whole numbers
  score: Real;          // Floating-point numbers
  userName: String;     // Text strings
  isActive: Boolean;    // True or False

begin

  // Initialise variables

  age := 25;
  score := 1.3;
  userName := 'Paul';
  isActive := True;


  // Output variables

  writeln(age);
  writeln(score);
  writeln(userName);
  writeln(isActive);

end.
