program mathsOps;

var num1,num2: Integer;

begin
  write('Enter num 1: ');
  readln(num1);

  write('Enter num 2: ');
  readln(num2);

  writeln(); // prints a blank line

  writeln(num1,' + ',num2,' = ',num1 + num2);
  writeln(num1,' - ',num2,' = ',num1 - num2);
  writeln(num1,' * ',num2,' = ',num1 * num2);
  writeln(num1,' / ',num2,' = ',num1 / num2);
end.
